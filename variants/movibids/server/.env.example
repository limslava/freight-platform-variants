# Copy to .env and fill in. A channel left empty is simply skipped.
PORT=8080
BRAND=MoviBids

# 1) Email (SMTP of your mail provider, e.g. Yandex 360: smtp.yandex.ru, 465)
SMTP_HOST=
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=
SMTP_PASS=
SMTP_FROM=
LEADS_EMAIL_TO=

# 2) Telegram: create a bot with @BotFather, add it to the team chat, put the chat id here
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# 3) Bitrix24: Developer resources → Other → Incoming webhook with CRM rights
#    URL looks like https://your-portal.bitrix24.ru/rest/1/abc123xyz/
BITRIX24_WEBHOOK_URL=

# Backup copy of every lead (one JSON per line)
LEADS_FILE=./leads.jsonl
